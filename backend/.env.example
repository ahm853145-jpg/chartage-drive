# ========================================
# CARTHAGE DRIVE - Backend Configuration
# ========================================
# Copy this to .env and update with your settings

# Application
APP_NAME=Carthage Drive
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/carthage-drive-backend

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=carthage_drive
DB_USERNAME=root
DB_PASSWORD=

# JWT Settings
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=86400

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8100
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Email Settings (for future use)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@carthagedrive.tn

# Upload Settings
UPLOAD_DIR=/uploads/cars
MAX_UPLOAD_SIZE=5242880

# Security
BCRYPT_ROUNDS=10

# Session
SESSION_TIMEOUT=3600
